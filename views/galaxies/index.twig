<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Galaxies</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <main class="container">
    <header>
      <h1>Galaxies</h1>
      <nav>
        <a href="/">Back to Home</a>
      </nav>
    </header>

    <section class="form-section">
      <h2>Add New Galaxy</h2>
      <form id="galaxiesForm" enctype="multipart/form-data">
        <input type="text" id="name" name="Name" placeholder="Galaxy Name" required>
        <input type="file" id="image" name="image" accept="image/*">
        <button type="submit">Add Galaxy</button>
      </form>
    </section>

    <section class="resources-section">
      <h2>All Galaxies</h2>
      <div id="galaxiesList" class="resources-grid">
        {% for galaxy in galaxies %}
          <article class="resource-card">
            {% if galaxy.image %}
              <img src="/uploads/galaxies/{{ galaxy.image }}" alt="{{ galaxy.Name }}">
            {% else %}
              <div class="no-image">No Image</div>
            {% endif %}
            <h3>{{ galaxy.Name }}</h3>
            <p>ID: {{ galaxy.id }}</p>
            <footer class="actions">
              <button class="edit-btn" data-id="{{ galaxy.id }}">Edit</button>
              <button class="delete-btn" data-id="{{ galaxy.id }}">Delete</button>
            </footer>
          </article>
        {% endfor %}
      </div>
    </section>
  </main>

  <script src="/resources.js"></script>
</body>
</html>
